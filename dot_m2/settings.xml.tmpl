<?xml version="1.0"?>
<settings>
    <mirrors>
        <mirror>
            <id>awv-central</id>
            <mirrorOf>external:*</mirrorOf>
            <url>https://collab.mow.vlaanderen.be/artifacts/repository/maven-public</url>
            <name>AWV Central</name>
        </mirror>
    </mirrors>
    <profiles>
        <profile>
            <id>nexus3</id>
            <repositories>
                <repository>
                    <id>awv-central</id>
                    <url>https://collab.mow.vlaanderen.be/artifacts/repository/maven-public</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>awv-central</id>
                    <url>https://collab.mow.vlaanderen.be/artifacts/repository/maven-public</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>nexus3</activeProfile>
    </activeProfiles>
    <servers>
        <server>
            <id>awv-central</id>
            <username>{{- (secretJSON "get" "--raw" "nexus.user.token").data.username }}</username>
	    <password>{{- (secretJSON "get" "--raw" "nexus.user.token").data.password }}</password>
        </server>
    </servers>
</settings>
